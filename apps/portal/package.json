{
  "name": "apps-portal",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "studio": "drizzle-kit studio",
    "studio:remote": "DB_REMOTE=true drizzle-kit studio",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply mykidstube --local",
    "db:migrate:remote": "wrangler d1 migrations apply mykidstube --remote",
    "typecheck": "tsc --noEmit",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@better-auth/passkey": "^1.7.7",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "@libsql/client": "^0.18.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
