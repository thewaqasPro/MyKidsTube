---
import '../styles/global.css';
import { UploadPage } from '../components/UploadPage';
import { getDbData } from '../lib/db';
import { getAuthenticatedParent } from '../lib/auth';

// Verify authentic server-side parent session
const auth = await getAuthenticatedParent(Astro);
if (!auth || auth.user?.role !== 'parent') {
  return Astro.redirect('/login?redirect=/upload');
}

const data = await getDbData(Astro);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Curate & Add Videos • MyKidsTube Studio</title>
    <meta
      name="description"
      content="Add safe YouTube videos, batch export download links for HandBrake, and upload optimized MP4 files directly to MyKidsTube."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-canvas text-text-primary antialiased font-sans">
    <UploadPage
      client:load
      categories={data.categories}
      profiles={data.profiles}
    />
  </body>
</html>
