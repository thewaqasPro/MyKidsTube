---
import '../../styles/global.css';
import { StudioDashboard } from '../../components/StudioDashboard';
import { getDatabase, getDbData, getStudioStats } from '../../lib/db';
import { getAuthenticatedParent } from '../../lib/auth';

// Verify authentic server-side parent session (Better Auth or Legacy PIN)
const auth = await getAuthenticatedParent(Astro);
if (!auth) {
  return Astro.redirect('/login?redirect=/studio');
}

const data = await getDbData(Astro);
const stats = await getStudioStats(Astro);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Parent Studio • MyKidsTube Command Center</title>
    <meta
      name="description"
      content="Parental administration dashboard for MyKidsTube. Monitor watch time, optimize videos with HandBrake, and manage child catalogs."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-canvas text-text-primary antialiased font-sans">
    <StudioDashboard
      client:load
      initialVideos={data.videos}
      initialCategories={data.categories}
      initialProfiles={data.profiles}
      initialStats={stats}
      currentUser={auth.user}
    />
  </body>
</html>
