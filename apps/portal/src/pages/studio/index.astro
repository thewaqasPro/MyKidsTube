---
import '../../styles/global.css';
import { StudioDashboard } from '../../components/StudioDashboard';
import { getDatabase, getDbData, getStudioStats } from '../../lib/db';
import { verifyParentSession } from '../../lib/parentAuth';

// Verify authentic server-side parent session
const db = await getDatabase(Astro);
const isAuthed = await verifyParentSession(Astro.request, db);
if (!isAuthed) {
  return Astro.redirect('/login?redirect=/studio');
}

const data = await getDbData(Astro);
const stats = await getStudioStats(Astro);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KidsTube Studio • Parent Management & Analytics</title>
    <meta
      name="description"
      content="Parental administration dashboard for KidsTube. Monitor watch time, optimize videos with HandBrake, and manage child catalogs."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0F0F0F] text-[#F1F1F1] antialiased">
    <StudioDashboard
      client:load
      initialVideos={data.videos}
      initialCategories={data.categories}
      initialProfiles={data.profiles}
      initialStats={stats}
    />
  </body>
</html>
