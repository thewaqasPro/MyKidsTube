---
import '../../styles/global.css';
import { WatchPage } from '../../components/WatchPage';
import { getVideoById, getDbData } from '../../lib/db';
import { isVideoShort } from '../../lib/constants';
import type { Video } from '../../types/video';

const { id } = Astro.params;

// 1. Strictly validate that the ID is a valid 11-character YouTube video ID
if (!id || !/^[a-zA-Z0-9_-]{11}$/.test(id)) {
  return new Response('Not Found', { status: 404, statusText: 'Not Found' });
}

// 2. Fetch strictly from curated database — do NOT dynamically synthesize uncurated videos
const video: Video | null = await getVideoById(id, Astro);
if (!video) {
  return new Response('Video Not Found in Curated Catalog', { status: 404, statusText: 'Not Found' });
}

const data = await getDbData(Astro);
const allVideos = data.videos || [];
const profiles = data.profiles || [];

// 3. Enforce layout: If this video is a short (<= 70s / vertical), redirect to vertical shorts feed!
if (isVideoShort(video)) {
  return Astro.redirect(`/shorts?v=${video.id}`);
}

// Related videos in the 16:9 watch player must only be full-length wide videos from the curated catalog
const relatedVideos = allVideos.filter((v) => v.id !== video.id && !isVideoShort(v));
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{video.title} • MyKidsTube</title>
    <meta
      name="description"
      content={`Watch ${video.title} on MyKidsTube. Safe, curated video streaming for children.`}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-canvas text-text-primary antialiased font-sans">
    <WatchPage
      client:load
      video={video}
      relatedVideos={relatedVideos}
      profiles={profiles}
    />
  </body>
</html>
