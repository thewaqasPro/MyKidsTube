# Cloudflare / Astro Portal Environment Configuration
# Minimum 32-character high-entropy secret for Better-Auth session signing
BETTER_AUTH_SECRET=your_better_auth_secret_minimum_32_characters_here
BETTER_AUTH_URL=http://localhost:4321

# VPS Storage Disk Cleanup Secret (must match CLEANUP_SECRET on VPS server)
VPS_CLEANUP_SECRET=your_vps_cleanup_secret_minimum_32_characters_here

# (Optional) Cloudflare D1 Remote Studio Configuration
DB_REMOTE=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
