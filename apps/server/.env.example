# Nginx Port Bindings
PORT_BINDING=8080
SSL_PORT_BINDING=8443

# Media directories (defaults to ./data/media/... for local dev)
MEDIA_VIDEOS_DIR=./data/media/videos
MEDIA_THUMBS_DIR=./data/media/thumbs

# Disk Cleanup Microservice Secret (32+ character high-entropy secret)
CLEANUP_SECRET=generate_a_secure_random_secret_minimum_32_characters
