{
  "expo": {
    "name": "KidsTube (RN)",
    "slug": "kidstube",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "plugins": [
      "react-native-video",
      "expo-sqlite",
      "expo-secure-store"
    ],
    "android": {
      "package": "com.safetube.safe_tube_rn",
      "allowBackup": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.safetube.safetube",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSAllowsArbitraryLoadsInWebContent": true
        }
      }
    }
  }
}
